generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         String // FIELD_STAFF, MINE_MANAGER, CORPORATE, REGULATOR, ADMIN
  phone        String
  language     String   @default("en")
  departmentId String?
  sectionId    String?
  mineId       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  mine       Mine?       @relation(fields: [mineId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])

  observations       Observation[]      @relation("ReportedObservations")
  assignedTasks      Task[]             @relation("AssignedTasks")
  verifiedTasks      Task[]             @relation("VerifiedTasks")
  taskEvidence       TaskEvidence[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  escalations        Escalation[]       @relation("EscalatedTo")
  complianceRecords  ComplianceRecord[] @relation("ResponsibleOfficer")
  verifiedCompliance ComplianceRecord[] @relation("ComplianceVerifier")
}

model Mine {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  location          String
  state             String
  district          String
  subsidiary        String
  mineType          String
  operationalStatus String   @default("Active")
  area              String
  commissioningDate String
  managerName       String
  contactPhone      String
  latitude          Float
  longitude         Float
  riskScore         Float    @default(25.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                User[]
  sections             Section[]
  departments          Department[]
  equipment            Equipment[]
  observations         Observation[]
  tasks                Task[]
  complianceRecords    ComplianceRecord[]
  riskScores           RiskScore[]
  emergencyResources   EmergencyResource[]
  productionRecords    ProductionRecord[]
  environmentalRecords EnvironmentalRecord[]
}

model Section {
  id              String   @id @default(uuid())
  code            String
  name            String
  mineId          String
  coordinatesJson String?
  riskLevel       String   @default("LOW") // LOW, MODERATE, HIGH, CRITICAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mine                 Mine                  @relation(fields: [mineId], references: [id], onDelete: Cascade)
  users                User[]
  equipment            Equipment[]
  observations         Observation[]
  tasks                Task[]
  complianceRecords    ComplianceRecord[]
  riskScores           RiskScore[]
  environmentalRecords EnvironmentalRecord[]
}

model Department {
  id        String   @id @default(uuid())
  code      String
  name      String
  mineId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mine  Mine?  @relation(fields: [mineId], references: [id], onDelete: Cascade)
  users User[]
  tasks Task[]
}

model Equipment {
  id                  String   @id @default(uuid())
  equipmentCode       String   @unique
  qrCode              String   @unique
  name                String
  type                String // Conveyor, Pump, Electrical, Dumper, Ventilation, Other
  mineId              String
  sectionId           String?
  manufacturer        String
  model               String
  installationDate    String
  lastMaintenanceDate String
  status              String   @default("NORMAL") // NORMAL, MAINTENANCE, CRITICAL
  lastInspectionDate  String
  latitude            Float?
  longitude           Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  mine         Mine          @relation(fields: [mineId], references: [id], onDelete: Cascade)
  section      Section?      @relation(fields: [sectionId], references: [id])
  observations Observation[]
  riskScores   RiskScore[]
}

model Observation {
  id                String   @id @default(uuid())
  observationNumber String   @unique
  mineId            String
  sectionId         String
  equipmentId       String?
  reportedById      String
  category          String // ELECTRICAL, MACHINERY, ROOF, VENTILATION, FIRE, PPE, ENVIRONMENT, OTHER
  severity          String // CRITICAL, HIGH, MEDIUM, LOW
  description       String
  hindiTranscript   String?
  englishReport     String?
  audioUrl          String?
  initialPhotoUrl   String?
  latitude          Float?
  longitude         Float?
  status            String   @default("REPORTED") // REPORTED, TASK_CREATED, RESOLVED, CLOSED
  offlineSyncId     String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mine          Mine           @relation(fields: [mineId], references: [id], onDelete: Cascade)
  section       Section        @relation(fields: [sectionId], references: [id])
  equipment     Equipment?     @relation(fields: [equipmentId], references: [id])
  reportedBy    User           @relation("ReportedObservations", fields: [reportedById], references: [id])
  task          Task?
  notifications Notification[]
}

model Task {
  id                 String    @id @default(uuid())
  taskNumber         String    @unique
  observationId      String    @unique
  mineId             String
  sectionId          String
  departmentId       String
  assignedToId       String
  title              String
  description        String
  category           String
  severity           String
  status             String    @default("REPORTED") // REPORTED, ASSIGNED, ACKNOWLEDGED, IN_PROGRESS, EVIDENCE_SUBMITTED, PENDING_VERIFICATION, CLOSED, REOPENED, OVERDUE, ESCALATED
  slaHours           Int
  slaDeadline        DateTime
  startedAt          DateTime?
  resolvedAt         DateTime?
  verifiedAt         DateTime?
  closedAt           DateTime?
  verificationStatus String? // PENDING, APPROVED, REJECTED
  rejectionReason    String?
  verifiedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  observation   Observation    @relation(fields: [observationId], references: [id], onDelete: Cascade)
  mine          Mine           @relation(fields: [mineId], references: [id], onDelete: Cascade)
  section       Section        @relation(fields: [sectionId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  assignedTo    User           @relation("AssignedTasks", fields: [assignedToId], references: [id])
  verifiedBy    User?          @relation("VerifiedTasks", fields: [verifiedById], references: [id])
  evidence      TaskEvidence[]
  escalations   Escalation[]
  notifications Notification[]
}

model TaskEvidence {
  id           String   @id @default(uuid())
  taskId       String
  uploadedById String
  evidenceType String // INITIAL, PROGRESS, FINAL, VERIFICATION
  fileUrl      String
  caption      String?
  latitude     Float?
  longitude    Float?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model Regulation {
  id                 String   @id @default(uuid())
  regulationCode     String   @unique
  officialSource     String
  name               String
  category           String // SAFETY, EQUIPMENT, ENVIRONMENT, EMERGENCY
  department         String
  frequency          String // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUAL
  defaultSlaHours    Int      @default(24)
  evidenceRequired   String
  description        String
  applicability      String
  effectiveDate      String
  verificationStatus String   @default("VERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  complianceRecords ComplianceRecord[]
}

model ComplianceRecord {
  id                   String    @id @default(uuid())
  regulationId         String
  mineId               String
  sectionId            String?
  responsibleOfficerId String
  status               String    @default("PENDING") // COMPLETED, PENDING, DUE_SOON, OVERDUE
  dueDate              DateTime
  completedDate        DateTime?
  evidenceUrl          String?
  notes                String?
  verifiedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  regulation         Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  mine               Mine       @relation(fields: [mineId], references: [id], onDelete: Cascade)
  section            Section?   @relation(fields: [sectionId], references: [id])
  responsibleOfficer User       @relation("ResponsibleOfficer", fields: [responsibleOfficerId], references: [id])
  verifiedBy         User?      @relation("ComplianceVerifier", fields: [verifiedById], references: [id])
}

model Escalation {
  id                 String    @id @default(uuid())
  taskId             String
  level              Int       @default(1) // 1 = Dept Head, 2 = Mine Manager, 3 = Corporate
  escalatedToId      String
  previousAssigneeId String?
  reason             String
  triggeredAt        DateTime  @default(now())
  acknowledgedAt     DateTime?
  createdAt          DateTime  @default(now())

  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  escalatedTo User @relation("EscalatedTo", fields: [escalatedToId], references: [id])
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String // NEW_TASK, CRITICAL_OBSERVATION, SLA_REMINDER, SLA_OVERDUE, ESCALATION, EVIDENCE_UPLOADED, TASK_APPROVED, TASK_REJECTED, COMPLIANCE_DUE, COMPLIANCE_OVERDUE
  title         String
  message       String
  taskId        String?
  observationId String?
  isRead        Boolean  @default(false)
  smsSent       Boolean  @default(false)
  smsLog        String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id])
  observation Observation? @relation(fields: [observationId], references: [id])
}

model RiskScore {
  id                  String   @id @default(uuid())
  mineId              String
  sectionId           String?
  equipmentId         String?
  score               Float // 0 - 100
  level               String // LOW (0-30), MODERATE (31-60), HIGH (61-100)
  factorBreakdownJson String // JSON containing severityWeight, overdueWeight, recurrenceWeight, etc.
  calculatedAt        DateTime @default(now())

  mine      Mine       @relation(fields: [mineId], references: [id], onDelete: Cascade)
  section   Section?   @relation(fields: [sectionId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
}

model AuditLog {
  id                String   @id @default(uuid())
  userId            String?
  userName          String
  action            String
  entity            String
  entityId          String
  previousStateJson String?
  newStateJson      String?
  metadataJson      String?
  timestamp         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model EmergencyResource {
  id            String   @id @default(uuid())
  mineId        String
  resourceType  String // AMBULANCE, FIRST_AID_STATION, RESCUE_TEAM, FIRE_TENDER, REFUGE_CHAMBER
  name          String
  location      String
  contactPerson String
  contactPhone  String
  status        String   @default("READY") // READY, DEPLOYED, UNDER_MAINTENANCE
  lastChecked   String
  createdAt     DateTime @default(now())

  mine Mine @relation(fields: [mineId], references: [id], onDelete: Cascade)
}

model ProductionRecord {
  id           String   @id @default(uuid())
  mineId       String
  date         String
  targetTonnes Float
  actualTonnes Float
  shift        String // Shift A, Shift B, Shift C
  remarks      String?
  createdAt    DateTime @default(now())

  mine Mine @relation(fields: [mineId], references: [id], onDelete: Cascade)
}

model EnvironmentalRecord {
  id               String   @id @default(uuid())
  mineId           String
  sectionId        String?
  recordedAt       DateTime @default(now())
  aqi              Float
  pm25             Float
  pm10             Float
  noiseDb          Float
  methanePpm       Float
  coPpm            Float
  waterDischargePh Float
  status           String   @default("NORMAL") // NORMAL, WARNING, HAZARD

  mine    Mine     @relation(fields: [mineId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id])
}
